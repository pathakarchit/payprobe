# ---- AI backend (pick ONE; all optional) ----
# Any OpenAI-compatible endpoint. Examples:
#   Local llama.cpp:   http://127.0.0.1:8081/v1
#   Ollama:            http://127.0.0.1:11434/v1   (model e.g. qwen2.5-coder:3b)
#   OpenAI:            https://api.openai.com/v1
#   Groq (free tier):  https://api.groq.com/openai/v1
PAYPROBE_AI_BASE_URL=
PAYPROBE_AI_KEY=
PAYPROBE_AI_MODEL=
# If none set, PayProbe uses a built-in offline analyst (no AI calls).

# ---- PayPal sandbox (only needed for `payprobe prove --sandbox`) ----
# Create a free app at https://developer.paypal.com/ -> Apps & Credentials -> Sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
